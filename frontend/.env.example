# AiCademy frontend environment variables (names and safe defaults only, never secrets).
# Copy to .env.local and adjust. The frontend must NEVER hold model-provider or service keys.

# Base URL of the REST API. With mocks on, MSW intercepts requests to this path.
VITE_API_BASE_URL=/api

# true  = serve every /api route from the in-browser MSW mock layer (src/mocks)
# false = send requests to the real Express backend at VITE_API_BASE_URL (ROADMAP Phase 1)
VITE_USE_MOCKS=true

# Developer switch to show/hide the instant demo persona switcher on login and topbar
VITE_ENABLE_DEMO_SWITCHER=false

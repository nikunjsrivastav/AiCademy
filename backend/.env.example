# AiCademy Backend Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=replace-with-a-secure-random-secret-key
CORS_ORIGIN=*
UPLOAD_DIR=uploads

# Database (MongoDB Atlas) - Starts completely clean with NO pre-seeding
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/aicademy?retryWrites=true&w=majority

# Vercel Blob Storage (for CDN PDF materials & submission uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini AI Provider (Google AI Studio Free Tier - gemini-1.5-flash / gemini-2.0-flash)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-1.5-flash

# Groq AI Provider (Optional Fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Microservices & Document Conversion
AI_SERVICE_URL=http://localhost:8000
DOCLING_API_URL=http://localhost:5001



# AiCademy Backend Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=replace-with-a-secure-random-secret-key
CORS_ORIGIN=*
UPLOAD_DIR=uploads

# Database (MongoDB Atlas) - Starts completely clean with NO pre-seeding
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/aicademy?retryWrites=true&w=majority

# Vercel Blob Storage (for CDN PDF materials & submission uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# Groq AI Provider (Llama 3.3 70B for RAG Tutor & Rubric Grading)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

